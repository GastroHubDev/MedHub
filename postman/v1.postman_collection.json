          "name": "Login MEDICO",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{urlAgendamento}}/api/auth/login"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"medico@hospital.com\",\n  \"senha\": \"senha123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('devolve token Bearer', () => { pm.expect(b.tipo).to.eql('Bearer'); pm.expect(b.token).to.be.a('string').and.not.empty; });",
                  "pm.test('perfil correto', () => pm.expect(b.perfil).to.eql('MEDICO'));",
