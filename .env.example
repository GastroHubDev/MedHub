# Portas de HOST publicadas pelo docker compose.
#
# Os padroes (faixa 81xx) foram escolhidos para nao disputar com outros projetos que convivem
# nesta maquina - 8080, 8081, 5432, 1025 e 8025 ja sao usadas por varios deles.
#
# Para usar valores proprios, copie este arquivo para .env e ajuste. O compose le .env
# automaticamente; nada mais precisa ser editado.
#
#   cp .env.example .env

PORTA_FRONT=3030            # console de testes - o ponto de entrada
PORTA_AGENDAMENTO=8180      # REST + Swagger
PORTA_NOTIFICACAO=8181      # trilha de notificacoes
PORTA_HISTORICO=8182        # GraphQL + GraphiQL
PORTA_KAFKA_UI=8190         # topicos, mensagens e lag dos consumer groups
PORTA_MAILHOG_WEB=8125      # caixa de entrada
PORTA_MAILHOG_SMTP=1125
PORTA_POSTGRES=5442

# Descomente para ver o agendador de lembretes disparando a cada minuto em vez das 08:00.
# CRON_LEMBRETES=0 * * * * *
